# Postgres connection string (Supabase: Project Settings -> Database -> Connection string -> URI, use the pooled "Transaction" mode port 6543 for the app and direct 5432 for migrations)
DATABASE_URL="replace-with-your-value"

# Supabase project settings (Project Settings -> API)
SUPABASE_URL="replace-with-your-value"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-value"

# JWT secrets used by the auth module (generate long random strings, do NOT reuse across environments)
JWT_SECRET="replace-with-your-value"
JWT_REFRESH_SECRET="replace-with-your-value"

# Access/refresh token lifetimes
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend origin allowed by CORS
FRONTEND_ORIGIN="http://localhost:3000"

PORT=4000

# Optional — backs both the dashboard cache (ReportsService.getDashboard())
# and the rate-limiter's shared counter (ThrottlerModule, app.module.ts)
# with real Redis instead of each one's single-process in-memory fallback
# used when this is unset. Required for correctness once the backend runs
# as more than one instance — otherwise each instance has its own separate
# cache AND its own separate rate-limit counter. A managed serverless Redis
# (e.g. Upstash) is a good fit here — no self-hosted Redis to operate.
REDIS_URL=""

# Optional — reports backend exceptions to Sentry (sentry.io project DSN).
# A no-op when unset: the SDK disables itself with a console warning,
# never throws, never sends anything. See src/instrument.ts.
SENTRY_DSN=""
